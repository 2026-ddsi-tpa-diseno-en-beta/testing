{
  "uid": "donatrack",
  "title": "DonaTrack — entrega 5",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Servicios disponibles",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "donatrack"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Solicitudes por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "donatrack"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Errores HTTP",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "donatrack"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Donaciones registradas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "donatrack"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "donatrack_donaciones_registradas_total",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Quejas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "donatrack"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "donatrack_donaciones_quejas_registradas_total",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Paquetes pendientes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "donatrack"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "logistica_paquetes_pendientes",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Ocupación total de depósitos",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "donatrack"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "logistica_deposito_ocupacion / clamp_min(logistica_deposito_capacidad,1)",
          "legendFormat": "{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Misiones revocadas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "donatrack"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "donatrack_incentivos_misiones_revocadas_total",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Necesidades creadas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "donatrack"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "donadores_necesidades_registradas_total",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Unidades entregadas a entidades",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "donatrack"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "donadores_necesidades_unidades_entregadas_total",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Donadores baneados",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "donatrack"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "donadores_baneados_total",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Entregas reportadas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "donatrack"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "logistica_entregas_reportadas_total",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Callbacks exitosos por worker",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "donatrack"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "logistica_worker_callbacks_exitosos_total{component=\"worker\"}",
          "legendFormat": "{{worker_id}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Errores por worker",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "donatrack"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "logistica_worker_errores_total{component=\"worker\"}",
          "legendFormat": "{{worker_id}}"
        }
      ]
    },
    {
      "id": 15,
      "title": "Donadores procesados por incentivos",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "donatrack"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "donatrack_incentivos_donadores_procesados_total",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 16,
      "title": "Duración media HTTP (segundos)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "donatrack"
      },
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component) (rate(http_server_requests_seconds_sum[5m])) / clamp_min(sum by (component) (rate(http_server_requests_seconds_count[5m])), 0.001)",
          "legendFormat": "{{component}}"
        }
      ]
    }
  ]
}
